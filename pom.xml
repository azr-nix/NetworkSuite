<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>online.rizzlers</groupId>
    <artifactId>RizzlersNetworkSuite</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>RizzlersNetworkSuite</name>
    <description>Enterprise network management and display tag suite for Velocity 4.3 and Purpur 26.3.</description>

    <modules>
        <module>proxy</module>
        <module>backend</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <velocity.version>4.3.0</velocity.version>
        <paper.version>26.3.build.209-stable</paper.version>
        <jda.version>5.2.2</jda.version>
        <hikari.version>5.1.0</hikari.version>
        <mariadb.version>3.5.2</mariadb.version>
        <sqlite.version>3.47.2.0</sqlite.version>
        <snakeyaml.version>2.2</snakeyaml.version>
        <junit.version>5.11.4</junit.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <name>PaperMC Maven Repository</name>
            <url>https://repo.papermc.io/repository/maven-public/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>purpurmc</id>
            <name>Purpur Maven Repository</name>
            <url>https://repo.purpurmc.org/snapshots</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>dv8tion</id>
            <name>m2-dv8tion</name>
            <url>https://m2.dv8tion.net/releases</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>
</project>
